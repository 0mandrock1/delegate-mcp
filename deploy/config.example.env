# Copy to /etc/delegate-mcp/config.env; owner root, mode 0644 (no secrets here).
DELEGATE_PUBLIC_URL=https://example.org/delegate/mcp
DELEGATE_AGENTS_PATH=/etc/delegate-mcp/AGENTS.md
# Optional allowlists for the privileged broker (exact systemd unit names without .service):
DELEGATE_ALLOWED_UNITS=nginx
DELEGATE_RESTARTABLE_UNITS=
# Optionally set DELEGATE_PORT=3549, DELEGATE_DB and DELEGATE_AUDIT.
