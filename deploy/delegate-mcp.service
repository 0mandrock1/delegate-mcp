[Unit]
Description=Temporary delegated MCP access to Hetzner VPS (separate from mandrock-ssh)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/delegate-mcp
ExecStart=/usr/bin/python3 /opt/delegate-mcp/delegate.py
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/delegate-mcp/config.env
Restart=on-failure
RestartSec=3
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
