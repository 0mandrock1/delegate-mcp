[Unit]
Description=Temporary delegated MCP access to Hetzner VPS (separate from mandrock-ssh)
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/projects/infra/delegate-mcp
ExecStart=/usr/bin/python3 /root/projects/infra/delegate-mcp/delegate.py
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=3
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
